{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birthday-site",
  "main": "src/index.js",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  }
}
