{
  "name": "birthday-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editorial birthday card — static site with a Cloudflare Worker for personalized social previews",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
